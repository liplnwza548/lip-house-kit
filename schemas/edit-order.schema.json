{"$schema": "http://json-schema.org/draft-07/schema#", "description": "Edit order: hook + body shots = one base clip (factories/edit reads this).", "required": ["proxy", "shots", "target_dur", "version"], "type": "object", "properties": {"version": {"const": 1}, "hook": {"description": "Hook clip file (plays first, untrimmed unless hook_trim set).", "properties": {"file": {"type": "string"}, "trim": {"type": "number"}}, "required": ["file"], "type": ["object", "null"]}, "proxy": {"description": "Source footage all body shots cut from.", "type": "string"}, "target_dur": {"type": "number"}, "shots": {"items": {"properties": {"d": {"type": "number"}, "id": {"type": "string"}, "note": {"type": "string"}, "ss": {"type": "number"}}, "required": ["id", "ss", "d"], "type": "object"}, "type": "array"}}}
